    "file_search" 'type;
    string[] vector_store_ids;
    anydata filters?;
    @constraint:Int {minValue: 1, maxValue: 50}
    int max_num_results?;
    OpenResponsesFileSearchTool_ranking_options ranking_options?;
};

public type OpenAIResponsesReasoningEffort "xhigh"|"high"|"medium"|"low"|"minimal"|"none";

