    string|string[]|decimal[]|decimal[][]|record {(record {"text" 'type; string text;}|record {"image_url" 'type; record {string url;} image_url;})[] content;}[] input;
    string model;
    "float"|"base64" encoding_format?;
    @constraint:Int {minValue: 0}
    int dimensions?;
    string user?;
    # Provider routing preferences for the request.
    ProviderPreferences provider?;
    string input_type?;
};

# Generation data
public type GenerationData record {
    # Unique identifier for the generation
    string id;
    # Upstream provider's identifier for this generation
    string upstream_id;
    # Total cost of the generation in USD
    decimal total_cost;
    # Discount applied due to caching
    decimal cache_discount;
    # Cost charged by the upstream provider
    decimal upstream_inference_cost;
    # ISO 8601 timestamp of when the generation was created
    string created_at;
    # Model used for the generation
    string model;
    # ID of the app that made the request
    decimal app_id;
    # Whether the response was streamed
    boolean streamed;
    # Whether the generation was cancelled
    boolean cancelled;
    # Name of the provider that served the request
    string provider_name;
    # Total latency in milliseconds
    decimal latency;
    # Moderation latency in milliseconds
    decimal moderation_latency;
    # Time taken for generation in milliseconds
    decimal generation_time;
    # Reason the generation finished
    string finish_reason;
    # Number of tokens in the prompt
    decimal tokens_prompt;
    # Number of tokens in the completion
    decimal tokens_completion;
    # Native prompt tokens as reported by provider
    decimal native_tokens_prompt;
    # Native completion tokens as reported by provider
    decimal native_tokens_completion;
    # Native completion image tokens as reported by provider
    decimal native_tokens_completion_images;
    # Native reasoning tokens as reported by provider
    decimal native_tokens_reasoning;
    # Native cached tokens as reported by provider
    decimal native_tokens_cached;
    # Number of media items in the prompt
    decimal num_media_prompt;
    # Number of audio inputs in the prompt
    decimal num_input_audio_prompt;
    # Number of media items in the completion
    decimal num_media_completion;
    # Number of search results included
    decimal num_search_results;
    # Origin URL of the request
    string origin;
    # Usage amount in USD
    decimal usage;
    # Whether this used bring-your-own-key
    boolean is_byok;
    # Native finish reason as reported by provider
    string native_finish_reason;
    # External user identifier
    string external_user;
    # Type of API used for the generation
    "completions"|"embeddings" api_type;
    # Router used for the request (e.g., openrouter/auto)
    string router;
    # List of provider responses for this generation, including fallback attempts
    record {string id?; string endpoint_id?; string model_permaslug?; "AnyScale"|"Atoma"|"Cent-ML"|"CrofAI"|"Enfer"|"GoPomelo"|"HuggingFace"|"Hyperbolic 2"|"InoCloud"|"Kluster"|"Lambda"|"Lepton"|"Lynn 2"|"Lynn"|"Mancer"|"Meta"|"Modal"|"Nineteen"|"OctoAI"|"Recursal"|"Reflection"|"Replicate"|"SambaNova 2"|"SF Compute"|"Targon"|"Together 2"|"Ubicloud"|"01.AI"|"AI21"|"AionLabs"|"Alibaba"|"Ambient"|"Amazon Bedrock"|"Amazon Nova"|"Anthropic"|"Arcee AI"|"AtlasCloud"|"Avian"|"Azure"|"BaseTen"|"BytePlus"|"Black Forest Labs"|"Cerebras"|"Chutes"|"Cirrascale"|"Clarifai"|"Cloudflare"|"Cohere"|"Crusoe"|"DeepInfra"|"DeepSeek"|"Featherless"|"Fireworks"|"Friendli"|"GMICloud"|"Google"|"Google AI Studio"|"Groq"|"Hyperbolic"|"Inception"|"Inceptron"|"InferenceNet"|"Ionstream"|"Infermatic"|"Io Net"|"Inflection"|"Liquid"|"Mara"|"Mancer 2"|"Minimax"|"ModelRun"|"Mistral"|"Modular"|"Moonshot AI"|"Morph"|"NCompass"|"Nebius"|"NextBit"|"Novita"|"Nvidia"|"OpenAI"|"OpenInference"|"Parasail"|"Perplexity"|"Phala"|"Relace"|"SambaNova"|"Seed"|"SiliconFlow"|"Sourceful"|"StepFun"|"Stealth"|"StreamLake"|"Switchpoint"|"Together"|"Upstage"|"Venice"|"WandB"|"Xiaomi"|"xAI"|"Z.AI"|"FakeProvider" provider_name?; decimal status; decimal latency?; boolean is_byok?;}[] provider_responses;
    # User-Agent header from the request
    string user_agent;
    # Referer header from the request
    string http_referer;
};

