# Current API key information
public type CurrentKeyData record {
    # Human-readable label for the API key
    string label;
    # Spending limit for the API key in USD
    decimal? 'limit;
    # Total OpenRouter credit usage (in USD) for the API key
    decimal usage;
    # OpenRouter credit usage (in USD) for the current UTC day
    decimal usage_daily;
    # OpenRouter credit usage (in USD) for the current UTC week (Monday-Sunday)
    decimal usage_weekly;
    # OpenRouter credit usage (in USD) for the current UTC month
    decimal usage_monthly;
    # Total external BYOK usage (in USD) for the API key
    decimal byok_usage;
    # External BYOK usage (in USD) for the current UTC day
    decimal byok_usage_daily;
    # External BYOK usage (in USD) for the current UTC week (Monday-Sunday)
    decimal byok_usage_weekly;
    # External BYOK usage (in USD) for current UTC month
    decimal byok_usage_monthly;
    # Whether this is a free tier API key
    boolean is_free_tier;
    # Whether this is a management key
    boolean is_management_key;
    # Whether this is a management key
    # 
    # # Deprecated
    @deprecated
    boolean is_provisioning_key;
    # Remaining spending limit in USD
    decimal? limit_remaining;
    # Type of limit reset for the API key
    string? limit_reset;
    # Whether to include external BYOK usage in the credit limit
    boolean? include_byok_in_limit;
    # ISO 8601 UTC timestamp when the API key expires, or null if no expiration
    string expires_at?;
    # The user ID of the key creator. For organization-owned keys, this is the member who created the key. For individual users, this is the user's own ID.
    string? creator_user_id;
    # Legacy rate limit information about a key. Will always return -1.
    KeyRateLimit rate_limit;
};

